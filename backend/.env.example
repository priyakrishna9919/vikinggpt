# ── VikingGPT Backend — Environment Variables ──
# Copy this file to .env and fill in real values
# Never commit .env to git

# Anthropic Claude API key — the ONLY paid key you need
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ChromaDB storage path — vector embeddings persisted here
CHROMA_PERSIST_PATH=./chroma_db

# Collection name inside ChromaDB
CHROMA_COLLECTION=csu_knowledge

# FastAPI server settings
HOST=0.0.0.0
PORT=8000

# CORS — set to your Vercel frontend URL in production
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# How often to re-scrape CSU pages (hours)
SCRAPE_INTERVAL_HOURS=24

# NOTE: No OpenAI key needed!
# Embeddings run locally using sentence-transformers (free, no API)
