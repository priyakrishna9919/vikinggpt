# ── VikingGPT Backend — Environment Variables ──
# Copy this file to .env and fill in your values
# Never commit .env to git

# Groq API key — FREE, no card needed
# Get it at: console.groq.com → sign in with Google → API Keys → Create key
GROQ_API_KEY=gsk_your_groq_key_here

# ChromaDB storage path — embeddings saved here on disk
CHROMA_PERSIST_PATH=./chroma_db

# ChromaDB collection name
CHROMA_COLLECTION=csu_knowledge

# FastAPI server settings
HOST=0.0.0.0
PORT=8000

# CORS — add your Vercel URL in production
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Re-scrape interval in hours
SCRAPE_INTERVAL_HOURS=24

# COST: $0.00
# LLM      → Groq free tier (Llama 3.3 70B)
# Embeddings → sentence-transformers (local, no API)
